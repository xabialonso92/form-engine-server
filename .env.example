# =============================================================
# Form Engine — Variables de entorno (Railway)
# Railway inyecta DATABASE_URL y REDIS_URL automáticamente.
# Solo necesitas configurar las 4 de abajo manualmente.
# =============================================================

# ── Inyectadas por Railway automáticamente ─────────────────────
# (no las copies, Railway las pone solo al conectar los servicios)
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...

# ── Configuras tú manualmente en Railway dashboard ─────────────
NODE_ENV=production
PORT=3000

# Stripe — dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Clave para proteger rutas de admin del Form Builder
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET_KEY=cambia_esto

# URL de tu frontend (para CORS)
ALLOWED_ORIGINS=https://tufrontend.com,http://localhost:5173
